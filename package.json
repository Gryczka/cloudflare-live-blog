{
  "name": "cloudflare-live-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A newsroom-style live blog built on Cloudflare Workers, Durable Objects, and Astro islands.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "start": "npm run dev",
    "build": "wrangler types && npm run check && astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/preact": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.3",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
